<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Video Player"
        Height="500" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="Black"
        WindowStyle="None"
        ResizeMode="CanResize"
        Focusable="True"
        LocationChanged="Window_LocationChanged"
        SizeChanged="Window_SizeChanged"
        StateChanged="Window_StateChanged">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="MainGrid">
        <!-- 
            VLC VideoView is now the primary content of the window.
            All UI controls are hosted in PlayerOverlayWindow.
        -->
        <vlc:VideoView x:Name="VideoPlayer" 
                       HorizontalAlignment="Stretch" 
                       VerticalAlignment="Stretch" />
    </Grid>
</Window>
