<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Video Player"
        Height="500" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PlayerBackgroundBrush}"
        FontFamily="{DynamicResource PlayerFontFamily}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        PreviewKeyDown="Window_PreviewKeyDown"
        Focusable="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" 
                      ResizeBorderThickness="8"
                      GlassFrameThickness="0"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- ── Button style ── -->
        <Style x:Key="PlayerButtonStyle" TargetType="Button">
            <Setter Property="Background"        Value="{DynamicResource PlayerButtonBgBrush}"/>
            <Setter Property="Foreground"        Value="{DynamicResource PlayerButtonFgBrush}"/>
            <Setter Property="BorderBrush"       Value="{DynamicResource PlayerButtonBgBrush}"/>
            <Setter Property="BorderThickness"   Value="0"/>
            <Setter Property="Padding"           Value="10,4"/>
            <Setter Property="Margin"            Value="6,0"/>
            <Setter Property="Cursor"            Value="Hand"/>
            <Setter Property="FontSize"          Value="{DynamicResource PlayerFontSizeSm}"/>
            <Setter Property="FontWeight"        Value="{DynamicResource PlayerButtonFontWeight}"/>
            <Setter Property="FontFamily"        Value="{DynamicResource PlayerFontFamilyUi}"/>
            <Setter Property="FocusVisualStyle"  Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="{DynamicResource PlayerButtonRadius}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PlayerButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PlayerPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Chrome button style (— □ X) — no border, no outline ── -->
        <Style x:Key="ChromeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PlayerTextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                Padding="0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PlayerElevatedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PlayerBorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Speed combo style ── -->
        <Style x:Key="SpeedComboStyle" TargetType="ComboBox">
            <Setter Property="FontSize"    Value="{DynamicResource PlayerFontSizeSm}"/>
            <Setter Property="FontFamily"  Value="{DynamicResource PlayerFontFamilyUi}"/>
            <Setter Property="Foreground"  Value="{DynamicResource PlayerButtonFgBrush}"/>
            <Setter Property="Background"  Value="{DynamicResource PlayerButtonBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PlayerButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border x:Name="Border"
                                                            Background="{DynamicResource PlayerButtonBgBrush}"
                                                            BorderBrush="{DynamicResource PlayerButtonBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="{DynamicResource PlayerButtonRadius}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition/>
                                                                <ColumnDefinition Width="20"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Path Grid.Column="1"
                                                                  Fill="{DynamicResource PlayerButtonFgBrush}"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  Data="M 0 0 L 4 4 L 8 0 Z"/>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Border" Property="Background"
                                                                    Value="{DynamicResource PlayerButtonHoverBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>

                            <ContentPresenter Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="5,3,23,3"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>

                            <Popup Name="Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown" SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="{DynamicResource PlayerButtonBgBrush}"
                                            BorderBrush="{DynamicResource PlayerButtonBorderBrush}"
                                            BorderThickness="1" Margin="0,1,0,0"
                                            CornerRadius="{DynamicResource PlayerButtonRadius}">
                                        <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True"
                                                        KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Slider style ── -->
        <Style x:Key="PlayerSliderStyle" TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Track x:Name="PART_Track" Grid.Row="1">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2"
                                                        Background="{DynamicResource PlayerPrimaryBrush}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="14" Height="14"
                                                         Fill="{DynamicResource PlayerButtonBgBrush}"
                                                         Stroke="{DynamicResource PlayerPrimaryBrush}"
                                                         StrokeThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2"
                                                        Background="{DynamicResource PlayerBorderBrush}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Combo item style ── -->
        <Style x:Key="DarkComboItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground"  Value="{DynamicResource PlayerButtonFgBrush}"/>
            <Setter Property="Background"  Value="{DynamicResource PlayerButtonBgBrush}"/>
            <Setter Property="FontFamily"  Value="{DynamicResource PlayerFontFamilyUi}"/>
            <Setter Property="FontSize"    Value="{DynamicResource PlayerFontSizeSm}"/>
            <Setter Property="Padding"     Value="4,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource PlayerButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource PlayerPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleRow" Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="NotesColumn" Width="0"/>
        </Grid.ColumnDefinitions>

        <!-- ── Title bar (spans both columns) ── -->
        <Grid Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource PlayerSurfaceBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Margin="8,0">
                <Button Content="Open"
                        Style="{StaticResource PlayerButtonStyle}"
                        Click="OpenButton_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True"/>
                <TextBlock x:Name="TitleText"
                           Text="Protected Video Player"
                           Foreground="{DynamicResource PlayerTextPrimaryBrush}"
                           FontFamily="{DynamicResource PlayerFontFamilyUi}"
                           FontSize="{DynamicResource PlayerFontSizeSm}"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,0,8,0">
                <Button Content="—" Width="40" Height="32"
                        Style="{StaticResource ChromeButtonStyle}"
                        Click="MinimizeButton_Click"/>
                <Button Content="□" Width="40" Height="32"
                        Style="{StaticResource ChromeButtonStyle}"
                        Click="MaximizeButton_Click"/>
                <Button Content="X" Width="40" Height="32"
                        Style="{StaticResource ChromeButtonStyle}"
                        Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- ── Video area ── -->
        <Grid x:Name="ContentGrid" Grid.Row="1" Grid.Column="0" Background="Black"
              MouseMove="ContentGrid_MouseMove"
              MouseLeftButtonDown="ContentGrid_MouseLeftButtonDown">

            <MediaElement x:Name="VideoPlayer"
                          LoadedBehavior="Manual" UnloadedBehavior="Stop"
                          Stretch="Uniform"
                          MediaOpened="VideoPlayer_MediaOpened"
                          MediaEnded="VideoPlayer_MediaEnded"
                          MediaFailed="VideoPlayer_MediaFailed"/>

            <!-- Loading overlay -->
            <Border x:Name="LoadingOverlay"
                    Background="#DD000000"
                    Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="LoadingText" Text="Connecting..."
                               Foreground="{DynamicResource PlayerTextPrimaryBrush}"
                               FontFamily="{DynamicResource PlayerFontFamilyUi}"
                               FontSize="{DynamicResource PlayerFontSizeLg}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="●  ●  ●"
                               Foreground="{DynamicResource PlayerPrimaryBrush}"
                               FontSize="20"
                               HorizontalAlignment="Center">
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0.3" To="1.0" Duration="0:0:0.6"
                                                         AutoReverse="True"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Fullscreen hint -->
            <Border x:Name="FullscreenHint"
                    Background="#BB000000"
                    CornerRadius="{DynamicResource PlayerRadiusMd}"
                    Padding="8"
                    HorizontalAlignment="Center" VerticalAlignment="Top"
                    Margin="0,15" Visibility="Collapsed">
                <TextBlock Text="Press F11 or Esc to exit fullscreen"
                           Foreground="White"
                           FontFamily="{DynamicResource PlayerFontFamilyUi}"
                           FontSize="{DynamicResource PlayerFontSizeSm}"/>
            </Border>

            <!-- ── Control bar (compact floating look, eats clicks) ── -->
            <Viewbox VerticalAlignment="Bottom" HorizontalAlignment="Center" 
                     Stretch="Uniform" MaxWidth="820" Margin="20,0,20,30">
                <Border x:Name="ControlBar"
                        Background="{DynamicResource PlayerControlBarBrush}"
                        CornerRadius="{DynamicResource PlayerCardRadius}"
                        BorderBrush="{DynamicResource PlayerCardBorderBrush}"
                        BorderThickness="1"
                        Padding="20,12"
                        Width="Auto" MinWidth="650"
                        Opacity="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="15" Direction="270" Color="Black" Opacity="0.6"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Progress bar -->
                    <Slider x:Name="ProgressSlider" Grid.Row="0"
                            Minimum="0" Height="14"
                            Style="{StaticResource PlayerSliderStyle}"
                            ValueChanged="ProgressSlider_ValueChanged"
                            PreviewMouseLeftButtonUp="ProgressSlider_MouseUp"/>

                    <!-- Time display -->
                    <TextBlock x:Name="TimeDisplay" Grid.Row="1"
                               Text="0:00 / 0:00"
                               Foreground="{DynamicResource PlayerTextPrimaryBrush}"
                               FontFamily="{DynamicResource PlayerFontFamilyUi}"
                               FontSize="{DynamicResource PlayerFontSizeSm}"
                               FontWeight="Medium"
                               HorizontalAlignment="Left"
                               Margin="2,6,0,0"/>

                    <!-- Controls row -->
                    <Grid Grid.Row="2" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: playback controls -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button ToolTip="Back 10s (←)"
                                    Click="SkipBackButton_Click"
                                    Style="{StaticResource PlayerButtonStyle}">
                                <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="M11 19V5L4 12L11 19ZM18 19V5L11 12L18 19Z" Fill="{DynamicResource PlayerButtonFgBrush}" Stretch="None"/></Canvas></Viewbox>
                            </Button>
                            <Button x:Name="PlayPauseButton"
                                    ToolTip="Play / Pause (Space or K)"
                                    Click="PlayPauseButton_Click"
                                    Style="{StaticResource PlayerButtonStyle}">
                                <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="M5 3l14 9-14 9V3z" Fill="{DynamicResource PlayerButtonFgBrush}" Stretch="None"/></Canvas></Viewbox>
                            </Button>
                            <Button ToolTip="Forward 10s (→)"
                                    Click="SkipForwardButton_Click"
                                    Style="{StaticResource PlayerButtonStyle}">
                                <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="M13 5V19L20 12L13 5ZM6 5V19L13 12L6 5Z" Fill="{DynamicResource PlayerButtonFgBrush}" Stretch="None"/></Canvas></Viewbox>
                            </Button>
                        </StackPanel>

                        <!-- Center: volume -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <ContentControl x:Name="VolumeIcon"
                                       Margin="0,0,8,0" Cursor="Hand"
                                       VerticalAlignment="Center"
                                       MouseLeftButtonUp="VolumeIcon_Click"
                                       ToolTip="Mute / Unmute (M)">
                                <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="M11 5L6 9H2v6h4l5 4V5z M15.54 8.46a5 5 0 0 1 0 7.08 M19.07 4.93a10 10 0 0 1 0 14.14" 
                                      Stroke="{DynamicResource PlayerTextPrimaryBrush}" StrokeThickness="1.8" Stretch="None" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox>
                            </ContentControl>
                            <Slider x:Name="VolumeSlider" Width="100" Height="14"
                                    Minimum="0" Maximum="100"
                                    Style="{StaticResource PlayerSliderStyle}"
                                    ValueChanged="VolumeSlider_ValueChanged"
                                    VerticalAlignment="Center"
                                    ToolTip="Volume (↑ / ↓)"/>
                            <TextBlock x:Name="VolumePercentText"
                                       Foreground="{DynamicResource PlayerTextPrimaryBrush}"
                                       FontFamily="{DynamicResource PlayerFontFamilyUi}"
                                       FontSize="{DynamicResource PlayerFontSizeXs}"
                                       Margin="6,0" Text="50%"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Right: speed + notes -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Speed:"
                                       Foreground="{DynamicResource PlayerTextPrimaryBrush}"
                                       FontFamily="{DynamicResource PlayerFontFamilyUi}"
                                       FontSize="{DynamicResource PlayerFontSizeXs}"
                                       Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <ComboBox x:Name="SpeedComboBox" Width="70"
                                      Style="{StaticResource SpeedComboStyle}"
                                      ItemContainerStyle="{StaticResource DarkComboItemStyle}"
                                      SelectionChanged="SpeedComboBox_SelectionChanged"
                                      ToolTip="Playback speed">
                                <ComboBoxItem Content="0.5x"/>
                                <ComboBoxItem Content="1x" IsSelected="True"/>
                                <ComboBoxItem Content="1.5x"/>
                                <ComboBoxItem Content="2x"/>
                            </ComboBox>
                            <Button ToolTip="Toggle Notes"
                                    Click="ToggleNotes_Click"
                                    Style="{StaticResource PlayerButtonStyle}"
                                    Margin="8,0,0,0">
                                <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M16 13H8 M16 17H8 M10 9H8" 
                                      Stroke="{DynamicResource PlayerButtonFgBrush}" StrokeThickness="1.8" Stretch="None" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
                </Border>
            </Viewbox>
        </Grid>

        <!-- ── Notes panel ── -->
        <Border Grid.Row="1" Grid.Column="1"
                Background="{DynamicResource PlayerSurfaceBrush}"
                BorderBrush="{DynamicResource PlayerBorderBrush}"
                BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0"
                        Background="{DynamicResource PlayerElevatedBrush}"
                        BorderBrush="{DynamicResource PlayerBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="12,8">
                    <Grid>
                        <TextBlock Text="Notes"
                                   Foreground="{DynamicResource PlayerTextPrimaryBrush}"
                                   FontFamily="{DynamicResource PlayerFontFamilyUi}"
                                   FontSize="{DynamicResource PlayerFontSizeBase}"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="NoteCountText"
                                   Text="± 30s"
                                   Foreground="{DynamicResource PlayerMutedBrush}"
                                   FontFamily="{DynamicResource PlayerFontFamilyUi}"
                                   FontSize="{DynamicResource PlayerFontSizeXs}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Notes list -->
                <ScrollViewer x:Name="NotesScrollViewer"
                              Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              Padding="0">
                    <ItemsControl x:Name="NotesList" Margin="0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="8,4"
                                        Padding="10,8"
                                        Background="{DynamicResource PlayerCardBgBrush}"
                                        BorderBrush="{DynamicResource PlayerBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource PlayerCardRadius}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <TextBlock Text="{Binding TimestampLabel}"
                                                       Foreground="{DynamicResource PlayerPrimaryBrush}"
                                                       FontFamily="{DynamicResource PlayerFontFamilyUi}"
                                                       FontSize="{DynamicResource PlayerFontSizeXs}"
                                                       FontWeight="Medium"
                                                       Cursor="Hand"
                                                       MouseLeftButtonUp="NoteTimestamp_Click"
                                                       ToolTip="Click to seek to this moment"/>
                                            <Button HorizontalAlignment="Right"
                                                    Style="{StaticResource ChromeButtonStyle}"
                                                    Width="18" Height="18"
                                                    Tag="{Binding}"
                                                    Click="DeleteNote_Click">
                                                <Viewbox Width="12" Height="12"><Canvas Width="24" Height="24"><Path Data="M18 6L6 18 M6 6l12 12" Stroke="{DynamicResource PlayerTextPrimaryBrush}" StrokeThickness="1.8" Stretch="None" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox>
                                            </Button>
                                        </Grid>
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Text}"
                                                   Foreground="{DynamicResource PlayerTextPrimaryBrush}"
                                                   FontFamily="{DynamicResource PlayerFontFamilyUi}"
                                                   FontSize="{DynamicResource PlayerFontSizeSm}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Input area -->
                <Border Grid.Row="2"
                        BorderBrush="{DynamicResource PlayerBorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                Background="{DynamicResource PlayerCardBgBrush}"
                                BorderBrush="{DynamicResource PlayerBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource PlayerInputRadius}">
                            <TextBox x:Name="NoteInput"
                                     Background="Transparent"
                                     Foreground="{DynamicResource PlayerTextPrimaryBrush}"
                                     BorderThickness="0"
                                     FontFamily="{DynamicResource PlayerFontFamilyUi}"
                                     FontSize="{DynamicResource PlayerFontSizeSm}"
                                     Padding="8,6"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="False"
                                     Height="60"
                                     VerticalScrollBarVisibility="Auto"
                                     CaretBrush="{DynamicResource PlayerTextPrimaryBrush}"
                                     KeyDown="NoteInput_KeyDown"/>
                        </Border>
                        <Button Grid.Row="1"
                                Content="Add Note"
                                Margin="0,6,0,0"
                                Style="{StaticResource PlayerButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Click="AddNote_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

    </Grid>
</Window>
